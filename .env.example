# Required for live voice. Server-side only — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional overrides
# Realtime model. Check https://platform.openai.com/docs/models for current names
# (e.g. gpt-realtime, gpt-realtime-mini, or newer gpt-realtime-2.x releases).
OPENAI_REALTIME_MODEL=gpt-realtime
# Model used to produce captions of what the user said.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional: require this shared code before a session token is issued
# (simple gate for private beta deployments; leave empty to disable).
APP_ACCESS_CODE=

# Max ephemeral sessions per IP per 10 minutes (in-memory, per server instance).
SESSION_RATE_LIMIT=20
